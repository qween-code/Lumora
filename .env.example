# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Lumora

# Supabase
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Database (for Prisma if using separate DB)
DATABASE_URL=postgresql://user:password@localhost:5432/lumora

# Stripe
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxxxx
STRIPE_SECRET_KEY=sk_test_xxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxx

# Stripe Price IDs
STRIPE_PRICE_CREATOR_MONTHLY=price_xxxxx
STRIPE_PRICE_CREATOR_ANNUAL=price_xxxxx
STRIPE_PRICE_PRO_MONTHLY=price_xxxxx
STRIPE_PRICE_PRO_ANNUAL=price_xxxxx

# AI Providers
FAL_API_KEY=your_fal_api_key
OPENAI_API_KEY=sk-xxxxx
REPLICATE_API_TOKEN=r8_xxxxx

# Storage
NEXT_PUBLIC_CLOUDFLARE_R2_PUBLIC_URL=https://your-bucket.r2.dev
CLOUDFLARE_R2_ACCESS_KEY_ID=xxxxx
CLOUDFLARE_R2_SECRET_ACCESS_KEY=xxxxx
CLOUDFLARE_R2_BUCKET_NAME=lumora-assets
CLOUDFLARE_R2_ENDPOINT=xxxxx

# Email (Optional - for transactional emails)
RESEND_API_KEY=re_xxxxx
RESEND_FROM_EMAIL=noreply@lumora.ai

# Analytics (Optional)
NEXT_PUBLIC_POSTHOG_KEY=phc_xxxxx
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com
